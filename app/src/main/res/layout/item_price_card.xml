<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_white">

    <!-- Nhãn cho thẻ giá (vd: GIÁ HIỆN TẠI) -->
    <TextView
        android:id="@+id/text_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GIÁ HIỆN TẠI"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_body"
        tools:text="CURRENT PRICE" />

    <!-- Số tiền hiển thị -->
    <TextView
        android:id="@+id/text_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2,500"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        tools:text="2,500" />

    <!-- Thông tin ngày áp dụng -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_calendar" />

        <TextView
            android:id="@+id/text_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Từ ngày 01/01/2024"
            android:textSize="12sp"
            android:textColor="@color/text_body"
            tools:text="Since Jan 01, 2024" />
    </LinearLayout>

    <!-- Hiển thị khi không có lịch thay đổi giá -->
    <TextView
        android:id="@+id/text_no_revision"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="CHƯA CÓ LỊCH THAY ĐỔI"
        android:textSize="12sp"
        android:textColor="@color/text_body"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>