<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Tạo Hóa Đơn Mới"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Thông tin cơ bản"
                android:textAllCaps="true"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Chọn căn hộ">
                        <AutoCompleteTextView
                            android:id="@+id/spinnerApartment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutBillingDate"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Kỳ hóa đơn (Tháng/Năm)"
                        app:startIconDrawable="@drawable/ic_calendar">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBillingDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none"
                            android:text="Chọn thời gian..." />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Bảng giá &amp; Thông số diện tích"
                android:textAllCaps="true"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="#FAFAFA">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Diện tích căn hộ:" android:textSize="13sp"/>
                        <TextView android:id="@+id/tvDisplayArea" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 m2" android:textStyle="bold" android:textColor="@color/black" android:textSize="13sp"/>
                    </LinearLayout>

                    <View style="@style/Divider" android:layout_marginVertical="8dp" android:alpha="0.3"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tvUnitPriceElec" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Điện: 0đ/kWh" android:textSize="12sp" android:textColor="#666666"/>
                        <TextView android:id="@+id/tvUnitPriceWater" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nước: 0đ/m3" android:textSize="12sp" android:textColor="#666666" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView android:id="@+id/tvUnitPriceMng" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Quản lý: 0đ/m2" android:textSize="12sp" android:textColor="#666666"/>
                        <TextView android:id="@+id/tvUnitPriceSani" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Vệ sinh: 0đ/tháng" android:textSize="12sp" android:textColor="#666666" android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Chỉ số &amp; Chi tiết phí"
                android:textAllCaps="true"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <ImageView android:id="@+id/imgElectric" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="16dp" android:src="@drawable/ic_electric" app:tint="@color/primary" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/imgElectric" android:layout_toStartOf="@id/layoutElectricOld" android:hint="Chỉ số điện mới">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etElectricNew" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout android:id="@+id/layoutElectricOld" android:layout_width="80dp" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:gravity="end" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số cũ" android:textSize="10sp" />
                            <TextView android:id="@+id/tvElectricOld" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                        <ImageView android:id="@+id/imgWater" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="16dp" android:src="@drawable/ic_water" app:tint="@color/primary" />
                        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_toEndOf="@id/imgWater" android:layout_toStartOf="@id/layoutWaterOld" android:hint="Chỉ số nước mới">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etWaterNew" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout android:id="@+id/layoutWaterOld" android:layout_width="80dp" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:gravity="end" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số cũ" android:textSize="10sp" />
                            <TextView android:id="@+id/tvWaterOld" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <View style="@style/Divider" android:layout_marginVertical="16dp" />

                    <RelativeLayout style="@style/DetailRow">
                        <TextView style="@style/DetailLabel" android:text="Phí quản lý" />
                        <TextView android:id="@+id/tvManagementFee" style="@style/DetailValueBold" android:text="0 VNĐ" />
                    </RelativeLayout>
                    <RelativeLayout style="@style/DetailRow">
                        <TextView style="@style/DetailLabel" android:text="Phí vệ sinh" />
                        <TextView android:id="@+id/tvSanitationFee" style="@style/DetailValueBold" android:text="0 VNĐ" />
                    </RelativeLayout>
                    <RelativeLayout style="@style/DetailRow">
                        <TextView style="@style/DetailLabel" android:text="Tiền điện (tạm tính)" />
                        <TextView android:id="@+id/tvElectricFee" style="@style/DetailValue" android:text="0 VNĐ" />
                    </RelativeLayout>
                    <RelativeLayout style="@style/DetailRow">
                        <TextView style="@style/DetailLabel" android:text="Tiền nước (tạm tính)" />
                        <TextView android:id="@+id/tvWaterFee" style="@style/DetailValue" android:text="0 VNĐ" />
                    </RelativeLayout>

                    <View style="@style/Divider" android:layout_marginVertical="12dp" />

                    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="4dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TỔNG THANH TOÁN" android:textColor="@color/black" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvTotalAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="0 VNĐ" android:textColor="@color/primary" android:textSize="18sp" android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnCreateBill"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/primary"
                android:text="LƯU HÓA ĐƠN"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>