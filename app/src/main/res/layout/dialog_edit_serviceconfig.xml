<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Phần Header của Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_camera_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_money"
            app:tint="@color/secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_close_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_body" />
    </LinearLayout>

    <!-- Tiêu đề chính -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chỉnh sửa Đơn giá"
        android:textColor="@color/text_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_service_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐIỆN"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Đặt lịch điều chỉnh đơn giá hiện tại cho các dịch vụ."
            android:textColor="@color/text_body"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Phần nhập giá mới -->
    <TextView
        android:id="@+id/tv_new_unit_price_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="ĐƠN GIÁ MỚI"
        android:textColor="@color/text_body"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_edittext_selector"
        android:padding="12dp">

        <EditText
            android:id="@+id/et_new_unit_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Nhập giá"
            android:inputType="numberDecimal"
            android:text="3.500"
            android:textColor="@color/text_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VND"
            android:textColor="@color/text_body"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Phần chọn ngày hiệu lực -->
    <TextView
        android:id="@+id/tv_effective_from_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="NGÀY HIỆU LỰC"
        android:textColor="@color/text_body"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        android:weightSum="2">

        <!-- Chọn tháng -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="4dp">
            
            <NumberPicker
                android:id="@+id/np_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>

        <!-- Chọn năm -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="4dp">

            <NumberPicker
                android:id="@+id/np_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ghi chú về ngày áp dụng -->
    <TextView
        android:id="@+id/tv_application_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Thay đổi sẽ được áp dụng từ 00:00 ngày 01 của tháng đã chọn."
        android:textColor="@color/text_body"
        android:textSize="12sp" />

    <!-- Nút hành động -->
    <Button
        android:id="@+id/btn_schedule_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_button"
        android:paddingVertical="16dp"
        android:text="Lên lịch thay đổi"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_calendar"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="Hủy"
        android:textStyle="bold"
        android:background="@drawable/bg_button_edit"
        android:textColor="@color/text_body"
        android:textSize="16sp" />

</LinearLayout>